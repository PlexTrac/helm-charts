# PlexTrac Helm Chart — Pre-Install Checklist
# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in your values.
#
# IMPORTANT: Only scripts/setup-registry-credentials.sh reads this file, and it
# uses only the DOCKER_* / CKEDITOR_DOCKER_* variables. Helm does NOT read this
# file. Every other variable here is a reference checklist — you copy its value
# into my-values.yaml yourself (each has a comment showing the field it maps to).
# Setting PLEXTRAC_DOMAIN here, for example, does not configure the chart; you
# must also set global.ingress.host in my-values.yaml.
#
# Sections:
#   A. Universal (all modes)
#   B. Manual mode      — chart creates Kubernetes Secrets from values
#   C. External Secrets — ESO pulls secrets from AWS SM / GCP SM / Vault / etc.
#   D. CSI mode         — Secrets Store CSI Driver syncs to Kubernetes Secrets
# ─────────────────────────────────────────────────────────────────────────────


# ═══════════════════════════════════════════════════════════════════════════════
# A. UNIVERSAL — required regardless of secrets mode
# ═══════════════════════════════════════════════════════════════════════════════

# Your hostname — must resolve to the ingress LoadBalancer IP via DNS.
# → global.ingress.host
PLEXTRAC_DOMAIN=plextrac.mycompany.com

# TLS strategy: cert-manager | pre-created-secret | inline | none
# See docs/user-guide.md § TLS configuration for full details.
#
# Primary cert-manager path — the chart creates the Issuer for you:
# → global.ingress.certManager.issuer   one of: selfSigned | letsencrypt | letsencrypt-staging | "" (none/BYO)
# → global.ingress.certManager.email    required for letsencrypt / letsencrypt-staging
CERT_MANAGER_ISSUER=
CERT_MANAGER_EMAIL=
# Bring-your-own issuer fallback — used ONLY when certManager.issuer is empty:
# → global.ingress.certManagerClusterIssuer
CERT_MANAGER_CLUSTER_ISSUER=
# → global.ingress.tlsSecretName  (all options)
TLS_SECRET_NAME=plextrac-com-tls

# Storage class — must match a StorageClass in your cluster.
# K3s: local-path  |  GKE: premium-rwo  |  AKS: managed-premium  |  EKS: gp3
# → storage.storageClassName
STORAGE_CLASS=local-path

# ── Docker Registry ────────────────────────────────────────────────────────────
#
# PlexTrac images require authentication. Fill in the three DOCKER_* variables
# below, then run:
#
#   ./scripts/setup-registry-credentials.sh
#
# That script will:
#   1. Create the Kubernetes image pull secret in your cluster
#   2. Print the my-values.yaml snippet to paste in
#
# CKEditor images (docker.cke-cs.com) use a separate credential — fill in the
# CKEDITOR_DOCKER_* variables too if you are using CKEditor.
#
# → global.imagePullSecrets
# → secrets.manual.generatedSecrets.registryCredentials  (manual mode)
# → secrets.externalSecrets.registryCredentials          (ESO mode)
#
# DOCKER_REGISTRY may be any Docker Registry HTTP API v2 or OCI-compliant registry
# (Docker Hub, Harbor, GHCR, ECR/GCR/ACR, a self-hosted registry, or a mirror/proxy).
#
# This file is shell-sourced, so values are subject to shell expansion. If your
# username or password contains a '$' (common for Harbor robot accounts, e.g.
# robot$myproject) or other shell metacharacters, wrap the value in SINGLE quotes
# so it is passed through literally:
#   DOCKER_USERNAME='robot$myproject'
#   DOCKER_PASSWORD='p@ss$word'
DOCKER_REGISTRY=https://index.docker.io/v1/   # change to your registry/mirror URL
DOCKER_USERNAME=
DOCKER_PASSWORD=

# CKEditor-specific (docker.cke-cs.com) — leave blank if not using CKEditor
CKEDITOR_DOCKER_SERVER=docker.cke-cs.com
CKEDITOR_DOCKER_USERNAME=
CKEDITOR_DOCKER_PASSWORD=


# ═══════════════════════════════════════════════════════════════════════════════
# B. MANUAL MODE  (secrets.mode: manual)
# ═══════════════════════════════════════════════════════════════════════════════
#
# The chart auto-generates all database passwords, encryption keys, and internal
# credentials. You only need to provide the values below.
#
# With createKubernetesSecrets: true (default), the chart creates the Kubernetes
# Secrets automatically. With createKubernetesSecrets: false, you create them
# yourself using the kubectl commands in secrets-modes.md § Option A.
#
# → Reference example: charts/plextrac/examples/values-self-hosted.yaml

# ── Optional ──────────────────────────────────────────────────────────────────

# Admin notification email. Leave blank if not needed — the chart installs without it.
# → secrets.manual.generatedSecrets.application.stringData.ADMIN_EMAIL
ADMIN_EMAIL=

# ── Optional integrations (leave blank to disable) ────────────────────────────

# CKEditor server license (enables collaborative editing features)
# → secrets.manual.generatedSecrets.shared.stringData.CKEDITOR_SERVER_LICENSE_KEY
CKEDITOR_SERVER_LICENSE_KEY=

# LaunchDarkly — feature flags
# → secrets.manual.generatedSecrets.shared.stringData.LAUNCH_DARKLY_SDK_KEY
LAUNCH_DARKLY_SDK_KEY=

# Pendo — product analytics
# → secrets.manual.generatedSecrets.shared.stringData.PENDO_API_KEY
PENDO_API_KEY=

# Sentry — error tracking
# → secrets.manual.generatedSecrets.shared.stringData.SENTRY_DSN_BACKEND
SENTRY_DSN_BACKEND=


# ═══════════════════════════════════════════════════════════════════════════════
# C. EXTERNAL SECRETS MODE  (secrets.mode: externalSecrets)
# ═══════════════════════════════════════════════════════════════════════════════
#
# Requires: External Secrets Operator installed + a ClusterSecretStore configured.
# The chart creates ExternalSecret objects; ESO syncs them from your secret store.
#
# You must pre-populate TWO secrets in your store before running helm install:
#   1. The "application" secret  (path = secrets.externalSecrets.application.remoteKey)
#   2. The "shared" secret       (path = secrets.externalSecrets.shared.remoteKey)
#
# → Reference example: charts/plextrac/examples/values-external-secrets.yaml
# ─────────────────────────────────────────────────────────────────────────────
#
# APPLICATION SECRET — store at your chosen remoteKey path
# All 47 keys must be present. Auto-generated keys can be any random value on
# first creation; keep them stable across updates (ESO does not rotate them).
#
# ── Optional (can be empty string, but key must exist) ───────────────────────
#   ADMIN_EMAIL                                   admin notification email
#
# ── Optional integrations (can be empty string, but key must exist) ───────────
#   CKEDITOR_SERVER_LICENSE_KEY
#   LAUNCH_DARKLY_SDK_KEY
#   PENDO_API_KEY
#   SENTRY_DSN_BACKEND
#
# ── Static defaults (these values match the docker-compose reference deploy) ──
#   CB_ADMIN_USER                 ptadminuser
#   CB_API_USER                   ptapiuser
#   CB_BACKUP_USER                ptbackupuser
#   CB_BUCKET                     reportMe
#   POSTGRES_USER                 internalonly
#   PG_CORE_DB                    core
#   PG_CORE_ADMIN_USER            core_admin
#   PG_CORE_RO_USER               core_ro
#   PG_CORE_RW_USER               core_rw
#   PG_CORE_AI_SQL_USER           ai_sql
#   PG_RUNBOOKS_DB                runbooks
#   PG_RUNBOOKS_ADMIN_USER        runbooks_admin
#   PG_RUNBOOKS_RO_USER           runbooks_ro
#   PG_RUNBOOKS_RW_USER           runbooks_rw
#   PG_CKEDITOR_DB                ckeditor
#   PG_CKEDITOR_ADMIN_USER        ckeditor_admin
#   PG_CKEDITOR_RO_USER           ckeditor_ro
#   PG_CKEDITOR_RW_USER           ckeditor_rw
#   MINIO_ROOT_USER               admin
#   MINIO_LOCAL_USER              localadmin
#
# ── Generate these as random values (min 32 chars recommended) ────────────────
#   CB_ADMIN_PASS
#   CB_API_PASS
#   CB_BACKUP_PASS
#   COOKIE_KEY
#   INTERNAL_API_KEY_SHARED
#   JWT_KEY
#   MFA_KEY
#   MINIO_LOCAL_PASSWORD
#   MINIO_ROOT_PASSWORD
#   PG_CKEDITOR_ADMIN_PASSWORD
#   PG_CKEDITOR_RO_PASSWORD
#   PG_CKEDITOR_RW_PASSWORD
#   PG_CORE_ADMIN_PASSWORD
#   PG_CORE_AI_SQL_PASSWORD
#   PG_CORE_RO_PASSWORD
#   PG_CORE_RW_PASSWORD
#   PG_RUNBOOKS_ADMIN_PASSWORD
#   PG_RUNBOOKS_RO_PASSWORD
#   PG_RUNBOOKS_RW_PASSWORD
#   POSTGRES_PASSWORD
#   REDIS_PASSWORD
#   API_INTEGRATION_AUTH_CONFIG_NOTIFICATION_SERVICE
#   CKEDITOR_ENVIRONMENT_SECRET_KEY
#   PROVIDER_CODE_KEY
#   CLOUD_STORAGE_SECRET_KEY
#
# ── Generate as 20-char random value ─────────────────────────────────────────
#   CLOUD_STORAGE_ACCESS_KEY
#
# SHARED SECRET — store at your chosen remoteKey path
# All 4 keys should be present (can be empty string if not used):
#   CKEDITOR_SERVER_LICENSE_KEY
#   LAUNCH_DARKLY_SDK_KEY
#   PENDO_API_KEY
#   SENTRY_DSN_BACKEND
#
# ── ESO connection settings ───────────────────────────────────────────────────
# → secrets.externalSecrets.secretStoreRef.kind   (ClusterSecretStore or SecretStore)
# → secrets.externalSecrets.secretStoreRef.name
ESO_SECRET_STORE_KIND=ClusterSecretStore
ESO_SECRET_STORE_NAME=

# → secrets.externalSecrets.application.remoteKey
ESO_APP_SECRET_REMOTE_KEY=plextrac/application-secrets

# → secrets.externalSecrets.shared.remoteKey
ESO_SHARED_SECRET_REMOTE_KEY=plextrac/shared-secrets

# → secrets.externalSecrets.registryCredentials.remoteKey  (if enabled)
ESO_REGISTRY_CREDS_REMOTE_KEY=plextrac/registry-credentials

# → secrets.externalSecrets.tls.remoteKey  (if enabled — must be a PKCS#12 bundle)
ESO_TLS_REMOTE_KEY=plextrac/tls-cert


# ═══════════════════════════════════════════════════════════════════════════════
# D. CSI MODE  (secrets.mode: csi)
# ═══════════════════════════════════════════════════════════════════════════════
#
# Requires: Secrets Store CSI Driver installed + provider configured.
# The chart creates a SecretProviderClass; the provider syncs secrets into
# Kubernetes Secrets named application-secrets and shared-secrets.
#
# You must pre-populate the same full key list as ESO mode (see Section C)
# in your provider's secret store (AWS Secrets Manager, GCP Secret Manager,
# Azure Key Vault, HashiCorp Vault, etc.).
#
# Configure secretObjects in your values to map provider secrets to the
# expected Kubernetes Secret names and key structure.
#
# → Reference examples:
#     charts/plextrac/examples/values-csi-aws.yaml
#     charts/plextrac/examples/values-csi-gcp.yaml
#
CSI_PROVIDER=            # aws | gcp | azure | vault
CSI_APP_SECRET_PATH=     # e.g. plextrac/application-secrets (AWS) or projects/*/secrets/* (GCP)
CSI_SHARED_SECRET_PATH=  # e.g. plextrac/shared-secrets
